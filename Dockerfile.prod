# ── Stage 1: Build React frontend ──────────────────────────────────────────
FROM node:20-slim AS frontend-build

WORKDIR /app/client
COPY client/package.json client/package-lock.json ./
RUN npm ci

COPY client/ ./
RUN npm run build
# Output: /app/client/dist


# ── Stage 2: Python backend + serve static files ────────────────────────────
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps for OpenCV / ML models
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# Resolve web + AI deps in one pass so pip sees every constraint (e.g. numpy<2).
# CPU-only torch wheels keep the image far smaller than the default CUDA build.
COPY backend/requirements-web.txt backend/requirements-ai.txt ./
RUN pip install --upgrade pip \
 && pip install --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements-web.txt -r requirements-ai.txt

COPY backend/ ./
COPY --from=frontend-build /app/client/dist ./static

# Run as an unprivileged user; it owns /app because model weights and the
# local vector store are written there at runtime.
RUN useradd --create-home app && chown -R app /app
USER app

EXPOSE 8000

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
